<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Health Connect permissions (read-only). Write permissions are intentionally
         omitted to enforce the read-only integration contract. -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />
    <uses-permission android:name="android.permission.health.READ_WEIGHT" />

    <!-- Declare the Health Connect data types the app reads, so the platform
         can route permission requests correctly. -->
    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

</manifest>
