{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://leanhome.app/schemas/user-profile.json","title":"UserProfile","description":"User biometric and fitness goal profile collected during onboarding.","type":"object","required":["id","name","age","gender","height_cm","weight_kg","country_code","body_shape","fitness_goal","available_equipment","injury_flags","days_per_week","daily_time_minutes","bmr","tdee","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"name":{"type":"string","minLength":1,"maxLength":50},"age":{"type":"integer","minimum":13,"maximum":99},"gender":{"type":"string","enum":["MALE","FEMALE","OTHER"]},"height_cm":{"type":"number","minimum":100,"maximum":250},"weight_kg":{"type":"number","minimum":30,"maximum":300},"country_code":{"type":"string","pattern":"^[A-Z]{2}$","description":"ISO 3166-1 alpha-2"},"body_shape":{"type":"string","enum":["INVERTED_TRIANGLE","RECTANGLE","OVAL","TRIANGLE","HOURGLASS","PEAR","APPLE"]},"fitness_goal":{"type":"string","enum":["HEALTH_MAINTENANCE","FAT_LOSS","WEIGHT_CUT","TARGET_ZONE_TONING"]},"target_muscle_group":{"type":"string","enum":["CHEST","BACK","SHOULDERS","ARMS","LEGS","GLUTES","CORE","FULL_BODY"]},"available_equipment":{"type":"array","items":{"type":"string","enum":["BODYWEIGHT_ONLY","RESISTANCE_BANDS","DUMBBELLS","PULL_UP_BAR","KETTLEBELL","BARBELL","FULL_GYM"]},"minItems":1},"injury_flags":{"type":"array","items":{"type":"string","enum":["NECK","SHOULDER","ELBOW","WRIST","LOWER_BACK","HIP","KNEE","ANKLE"]}},"activity_level":{"type":"string","enum":["SEDENTARY","LIGHTLY_ACTIVE","MODERATELY_ACTIVE","VERY_ACTIVE"],"default":"SEDENTARY"},"days_per_week":{"type":"integer","minimum":2,"maximum":6},"daily_time_minutes":{"type":"integer","minimum":15,"maximum":120},"target_weight_kg":{"type":"number","minimum":30,"maximum":300},"target_days":{"type":"integer","minimum":7,"maximum":365},"bmr":{"type":"number","description":"Basal Metabolic Rate (kcal/day) computed via Mifflin-St Jeor"},"tdee":{"type":"number","description":"Total Daily Energy Expenditure (kcal/day) = BMR * PAL"},"created_at":{"type":"integer","description":"Unix epoch timestamp"}}}