{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://leanhome.app/schemas/workout-session.json","title":"WorkoutSession","description":"A scheduled or completed workout session record.","type":"object","required":["id","user_id","scheduled_date","split_name","status","created_at"],"properties":{"id":{"type":"string","format":"uuid"},"user_id":{"type":"string","format":"uuid"},"scheduled_date":{"type":"string","format":"date","description":"ISO 8601 date (YYYY-MM-DD)"},"split_name":{"type":"string","enum":["FULL_BODY_A","FULL_BODY_B","UPPER_A","UPPER_B","LOWER_A","LOWER_B","PUSH","PULL","LEGS","FOCUS"]},"status":{"type":"string","enum":["PENDING","COMPLETED","SKIPPED"]},"exercises":{"type":"array","items":{"$ref":"#/$defs/session_exercise"}},"completed_duration_seconds":{"type":"integer","minimum":0},"rpe_score":{"type":"integer","minimum":1,"maximum":10},"feedback_tags":{"type":"array","items":{"type":"string","enum":["GREAT","TIRED","JOINT_DISCOMFORT","ENERGIZED","BREEZY","BRUTAL"]}},"feedback_notes":{"type":"string","maxLength":500},"created_at":{"type":"integer","description":"Unix epoch timestamp"}},"$defs":{"session_exercise":{"type":"object","required":["exercise_id","planned_sets","planned_reps"],"properties":{"exercise_id":{"type":"string"},"planned_sets":{"type":"integer","minimum":1,"maximum":10},"planned_reps":{"type":"integer","minimum":1,"maximum":100},"planned_rest_seconds":{"type":"integer","minimum":15,"maximum":300},"actual_sets_completed":{"type":"integer","minimum":0},"actual_reps_completed":{"type":"array","items":{"type":"integer","minimum":0}}}}}}